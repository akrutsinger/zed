#!/usr/bin/env bash
set -euo pipefail

# Cross-compiles the remote server for illumos with the GCC toolchain and illumos
# sysroot that rust-lang uses for its own illumos builds, as packaged by cross-rs.
# cargo-zigbuild, used for FreeBSD, doesn't support illumos targets.
image=ghcr.io/cross-rs/x86_64-unknown-illumos@sha256:e3bbd7629a7285a2e72b261d204d7a8beabdc087fdee7b96450e800207d44ace
target=x86_64-unknown-illumos

usage() {
    echo "Usage: $0 [--release]"
}

profile=debug
cargo_arguments=()
if (( $# > 1 )); then
    usage >&2
    exit 2
fi
case "${1:-}" in
    "")
        # Without embedded assets a dev server only runs from inside a checkout.
        cargo_arguments+=(--features debug-embed)
        ;;
    --release)
        profile=release
        cargo_arguments+=(--release --config .cargo/bundle-config.toml)
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac

cd "$(dirname "$0")/.."

# The image sets CROSS_SYSROOT. Outside it, rerun this script inside it with the
# host's rustup and Cargo homes, so toolchains, the registry and target/ persist.
if [[ -z "${CROSS_SYSROOT:-}" ]]; then
    rustup target add "$target"
    engine=${CONTAINER_ENGINE:-docker}
    user_arguments=(--user "$(id -u):$(id -g)")
    if "$engine" --version | grep -qi podman; then
        user_arguments=(--userns=keep-id)
    fi
    exec "$engine" run --rm "${user_arguments[@]}" \
        --volume "$PWD:/zed" --workdir /zed \
        --volume "${CARGO_HOME:-$HOME/.cargo}:/cargo" --env CARGO_HOME=/cargo \
        --volume "${RUSTUP_HOME:-$HOME/.rustup}:/rustup" --env RUSTUP_HOME=/rustup \
        --env HOME=/tmp \
        --env CARGO_BUILD_JOBS --env CARGO_INCREMENTAL --env CARGO_PROFILE_DEV_DEBUG \
        --env CARGO_TERM_COLOR --env RUST_BACKTRACE \
        "$image" ./script/build-remote-server-illumos "$@"
fi

export PATH="$CARGO_HOME/bin:$PATH"
# rustc only accepts split-debuginfo=off on illumos; Zed's dev profile sets unpacked.
export CARGO_PROFILE_DEV_SPLIT_DEBUGINFO=off
# This GCC targets generic Solaris. illumos compilers also define __illumos__, which
# C dependencies such as tree-sitter check to choose illumos headers. Like GCC 14,
# reject implicit declarations, which GCC 8 accepts and leaves to fail at link time.
export CFLAGS_x86_64_unknown_illumos="-D__illumos__ -Werror=implicit-function-declaration"
export CXXFLAGS_x86_64_unknown_illumos="-D__illumos__"

cargo build --locked "${cargo_arguments[@]}" --package remote_server --bin remote-server --target "$target"

target_directory=${CARGO_TARGET_DIR:-$PWD/target}
binary="$target_directory/$target/$profile/remote-server"
echo "Stripping artifact..."
x86_64-unknown-illumos-objcopy --strip-all "$binary" "$binary.stripped"
echo "Compressing artifact..."
gzip -c -n --best "$binary.stripped" > "$target_directory/zed-remote-server-illumos-x86_64.gz"
rm "$binary.stripped"
